# Copie este arquivo para .env:   cp .env.example .env
# O .env não vai para o GitHub (está no .gitignore): é nele que ficam as senhas.

# Banco de dados (usados pelo contêiner do PostgreSQL e pela API)
POSTGRES_USER=vila
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=doacoes

# Porta do banco na sua máquina (troque se a 5432 já estiver em uso)
DB_PORT=5432

# Porta da API na sua máquina (http://localhost:8000)
API_PORT=8000

# 1 = modo de desenvolvimento: recarrega ao salvar e mostra erros detalhados.
# Nunca use 1 em produção.
FLASK_DEBUG=1
