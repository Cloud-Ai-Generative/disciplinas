{
  // Ambiente da API de doações (Vila Esperança) no GitHub Codespaces.
  // No GitHub: Code → Codespaces → "..." → New with options → escolha
  // "Desenvolvimento Back-end Senac: API Vila Esperança".
  "name": "Desenvolvimento Back-end Senac: API Vila Esperança",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "workspaceFolder": "/workspaces/disciplinas/desenvolvimento-back-end-senac/api",
  "postCreateCommand": "cp -n .env.example .env || true",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "API de doações", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "MS-CEINTL.vscode-language-pack-pt-BR",
        "ms-python.python",
        "humao.rest-client",
        "ms-azuretools.vscode-containers",
        "ms-ossdata.vscode-pgsql"
      ]
    }
  }
}
