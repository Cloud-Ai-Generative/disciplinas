;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1737" y="316" width="32" height="32" as="geometry"/></mxCell><mxCell id="sl_tx" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Sistema do lojista&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e3a8a&#x27;&gt;recebe os WebHooks&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="1774" y="312" width="115" height="69" as="geometry"/></mxCell><mxCell id="banco" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1728" y="520" width="165" height="85" as="geometry"/></mxCell><mxCell id="banco_tag" value="EXTERNO" style="rounded=1;arcSize=50;html=1;fillColor=#64748b;strokeColor=#64748b;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1734" y="511" width="63" height="18" as="geometry"/></mxCell><mxCell id="banco_ic" value="" style="shape=mxgraph.networks.mainframe;html=1;fillColor=#64748b;gradientColor=none;strokeColor=#ffffff;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1737" y="536" width="32" height="32" as="geometry"/></mxCell><mxCell id="banco_tx" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Banco parceiro&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e3a8a&#x27;&gt;legado, só SOAP&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="1774" y="532" width="115" height="69" as="geometry"/></mxCell><mxCell id="u1" value="1. resolve o nome" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="app" target="dns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="u2" value="2. HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#dc2626;strokeWidth=2.5;fontColor=#991b1b;fontStyle=1;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="app" target="bar0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="216" y="324"/><mxPoint x="216" y="440"/></Array></mxGeometry></mxCell><mxCell id="u5a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#dc2626;strokeWidth=2.5;fontColor=#991b1b;fontStyle=1;exitX=0.157;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bar1" target="nodea"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="u5b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#dc2626;strokeWidth=2.5;fontColor=#991b1b;fontStyle=1;exitX=0.500;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bar1" target="nodeb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="u5c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#dc2626;strokeWidth=2.5;fontColor=#991b1b;fontStyle=1;exitX=0.843;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bar1" target="nodec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="egr" value="saída" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;dashed=1;dashPattern=2 3;fontColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bar2" target="sl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1700" y="497"/><mxPoint x="1700" y="342"/></Array></mxGeometry></mxCell><mxCell id="vpn" value="VPN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;exitX=1;exitY=0.33;entryX=0;entryY=0.5;" edge="1" parent="1" source="vpc" target="banco"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="leg" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;&lt;b&gt;Pods:&lt;/b&gt; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#dbeafe;border:2px solid #2563eb&#x27;&gt;&lt;/span&gt; microsserviço de domínio (tracejado: consumidor) &amp;nbsp; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#cffafe;border:2px solid #0891b2&#x27;&gt;&lt;/span&gt; BFF &amp;nbsp; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#fae8ff;border:2px solid #a21caf&#x27;&gt;&lt;/span&gt; adaptador &amp;nbsp; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#f1f5f9;border:2px solid #475569&#x27;&gt;&lt;/span&gt; coletor&lt;br&gt;&lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#dcfce7;border:2px solid #16a34a&#x27;&gt;&lt;/span&gt; banco: primária (contínua) e reserva (tracejada)&lt;br&gt;&lt;span style=&#x27;color:#0369a1&#x27;&gt;▭&lt;/span&gt; coluna azul: zona de disponibilidade &amp;nbsp; &lt;span style=&#x27;color:#0891b2&#x27;&gt;┅&lt;/span&gt; faixa tracejada: sub-rede ou rede que atravessa as zonas&lt;br&gt;&lt;span style=&#x27;color:#dc2626&#x27;&gt;━━&lt;/span&gt; caminho de uma requisição &amp;nbsp; &lt;span style=&#x27;color:#dc2626&#x27;&gt;╍╍&lt;/span&gt; replicação &amp;nbsp; &lt;span style=&#x27;color:#94a3b8&#x27;&gt;┈┈&lt;/span&gt; saída para a internet&lt;br&gt;&lt;b&gt;Réplicas:&lt;/b&gt; Pagamentos, Antifraude, Contas e BFF com 3 (uma por zona); os demais com 2, em zonas diferentes, espalhados pelo Kubernetes (topologySpreadConstraints, Sprint 8).&lt;br&gt;Ícones: bibliotecas oficiais do draw.io." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1150" width="700" height="200" as="geometry"/></mxCell><mxCell id="falha" value="&lt;b&gt;⚠️ E se a zona 1 cair?&lt;/b&gt;&lt;br&gt;1. O Application Gateway e o API Management, redundantes entre zonas, param de enviar tráfego para a zona 1.&lt;br&gt;2. As réplicas das zonas 2 e 3 continuam atendendo. O Kubernetes recria os pods perdidos nos nós das outras zonas, se houver capacidade (autoscaling, Sprint 9).&lt;br&gt;3. O PostgreSQL promove a reserva da zona 2. A documentação fala em 60 a 120 segundos, sem perda de dados, e os clientes reconectam no mesmo nome (retry, Sprint 9).&lt;br&gt;4. O NAT Gateway StandardV2 é redundante entre zonas: a saída para a internet continua.&lt;br&gt;5. Os serviços regionais seguem funcionando se a camada contratada tiver redundância de zona.&lt;br&gt;&lt;b&gt;Armadilha:&lt;/b&gt; três réplicas na mesma zona não protegem contra a queda da zona." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="1150" width="640" height="200" as="geometry"/></mxCell><mxCell id="ler" value="&lt;b&gt;O que muda em relação à AWS&lt;/b&gt;&lt;br&gt;No Azure, as sub-redes são regionais e atravessam as zonas, diferente da AWS, onde cada sub-rede fica em uma zona. Entrada, API Management e NAT são recursos redundantes entre zonas, e não um por zona.&lt;br&gt;O desenho de solução (Sprint 13) mostra o que existe; esta visão mostra onde cada peça roda e como o sistema sobrevive a falhas." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="1150" width="500" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dep-gcp" name="Implantação · Google Cloud"><mxGraphModel dx="1920" dy="1370" grid="1" gridSize="10" guides="1" page="1" pageWidth="1920" pageHeight="1370" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&#x27;font-size:22px&#x27;&gt;PagUai · Visão de implantação e resiliência · Sprints 8 e 9 · Google Cloud&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:14px;color:#475569&#x27;&gt;Pergunta que este desenho responde: onde cada peça roda fisicamente e o que acontece se uma zona de disponibilidade cair? Uma composição possível, não a única. Empresa e dados fictícios.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1880" height="60" as="geometry"/></mxCell><mxCell id="zu" value="" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="190" height="1070" as="geometry"/></mxCell><mxCell id="zu_h" value="1. Usuários e DNS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7c3aed;strokeColor=#7c3aed;fontColor=#ffffff;fontStyle=1;fontSize=13;align=left;spacingLeft=34;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="190" height="26" as="geometry"/></mxCell><mxCell id="zu_hb" value="" style="rounded=1;arcSize=20;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="25" y="62.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="zu_hi" value="" style="shape=mxgraph.networks.users;html=1;fillColor=#7c3aed;gradientColor=none;strokeColor=#ffffff;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="27" y="64.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="dns" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0d9488;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="28" y="125" width="175" height="115" as="geometry"/></mxCell><mxCell id="dns_tag" value="BORDA · DNS" style="rounded=1;arcSize=50;html=1;fillColor=#0d9488;strokeColor=#0d9488;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="34" y="116" width="91" height="18" as="geometry"/></mxCell><mxCell id="dns_ic" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="37" y="141" width="32" height="32" as="geometry"/></mxCell><mxCell id="dns_tx" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Cloud DNS&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e293b&#x27;&gt;DNS gerenciado&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e293b&#x27;&gt;traduz o nome da API&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e3a8a&#x27;&gt;em endereço&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="74" y="137" width="125" height="99" as="geometry"/></mxCell><mxCell id="app" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7c3aed;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="28" y="290" width="175" height="85" as="geometry"/></mxCell><mxCell id="app_tag" value="FRONT-END" style="rounded=1;arcSize=50;html=1;fillColor=#7c3aed;strokeColor=#7c3aed;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="34" y="281" width="77" height="18" as="geometry"/></mxCell><mxCell id="app_ic" value="" style="shape=mxgraph.networks.mobile;html=1;fillColor=#7c3aed;gradientColor=none;strokeColor=#ffffff;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="37" y="306" width="32" height="32" as="geometry"/></mxCell><mxCell id="app_tx" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;App PagUai&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e293b&#x27;&gt