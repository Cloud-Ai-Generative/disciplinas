34a;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="489" y="923" width="200" height="28" as="geometry"/></mxCell><mxCell id="dbb5" value="&lt;b&gt;reserva&lt;/b&gt; · notificacoes" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.5;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="964" y="923" width="200" height="28" as="geometry"/></mxCell><mxCell id="dba6" value="&lt;b&gt;primária&lt;/b&gt; · webhooks" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="279" y="957" width="200" height="28" as="geometry"/></mxCell><mxCell id="dbb6" value="&lt;b&gt;reserva&lt;/b&gt; · webhooks" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.5;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="754" y="957" width="200" height="28" as="geometry"/></mxCell><mxCell id="dba_tx" value="Amazon RDS for PostgreSQL 17 · 7 instâncias Multi-AZ&lt;br&gt;a primária atende leituras e escritas" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="279" y="995" width="420" height="40" as="geometry"/></mxCell><mxCell id="dbb_tx" value="As reservas recebem cada escrita em tempo real e não atendem consultas: só assumem se a primária falhar." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="754" y="995" width="420" height="50" as="geometry"/></mxCell><mxCell id="dbc_tx" value="&lt;b&gt;Sem banco nesta zona.&lt;/b&gt;&lt;br&gt;Neste desenho, primárias e reservas ficam nas zonas A e B. A zona C roda só aplicação." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="1229" y="855" width="420" height="70" as="geometry"/></