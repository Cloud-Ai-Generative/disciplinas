" y="60" width="1480" height="26" as="geometry"/></mxCell><mxCell id="reg_hb" value="" style="rounded=1;arcSize=20;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="230" y="62.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="reg_hi" value="" style="shape=mxgraph.office.concepts.globe_internet;html=1;strokeColor=#1e293b;fillColor=#ffffff;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="232" y="64.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="rs" value="" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="240" y="95" width="1450" height="160" as="geometry"/></mxCell><mxCell id="rs_h" value="Serviços regionais gerenciados · a AWS distribui cada um entre as zonas · você não escolhe a zona" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#475569;strokeColor=#475569;fontColor=#ffffff;fontStyle=1;fontSize=13;align=left;spacingLeft=34;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="95" width="1450" height="26" as="geometry"/></mxCell><mxCell id="rs_hb" value="" style="rounded=1;arcSize=20;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="245" y="97.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="rs_hi" value="" style="shape=mxgraph.office.concepts.settings;html=1;strokeColor=#475569;fillColor=#ffffff;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="247" y="99.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="waf" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0d9488;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="255" y="140" width="170" height="95" as="geometry"/></mxCell><mxCell id="waf_tag" value="BORDA · WAF" style="rounded=1;arcSize=50;html=1;fillColor=#0d9488;strokeColor=#0d9488;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="261" y="131" width="91"