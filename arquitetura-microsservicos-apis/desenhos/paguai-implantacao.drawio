"Cada caixa é um pod. Cada pod roda a imagem Docker de um componente." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="650" y="627" width="1190" height="24" as="geometry"/></mxCell><mxCell id="porta" value="&lt;b&gt;localhost:8080&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;porta publicada pelo kind&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0d9488;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="190" height="50" as="geometry"/></mxCell><mxCell id="l1" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#dc2626;strokeWidth=2.5;fontColor=#991b1b;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="voce" target="porta"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#dc2626;strokeWidth=2.5;fontColor=#991b1b;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="porta" target="w0_0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="245" y="295"/><mxPoint x="245" y="133"/><mxPoint x="645" y="133"/><mxPoint x="645" y="239"/></Array></mxGeometry></mxCell><mxCell id="l3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="kubectl" target="cp0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="258" y="447"/><mxPoint x="258" y="213"/></Array></mxGeometry></mxCell><mxCell id="l4" value="agenda os pods" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;dashed=1;dashPattern=2 3;fontColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="cp2" target="wk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="falha" value="&lt;b&gt;⚠️ E se algo cair no laboratório?&lt;/b&gt;&lt;br&gt;&lt;b&gt;Um pod de Pagamentos:&lt;/b&gt; a outra réplica continua atendendo, e o Kubernetes recria o pod perdido.&lt;br&gt;&lt;b&gt;O nó worker:&lt;/b&gt; tudo para, porque há um único nó de aplicação. As 2 réplicas protegem contra a queda de um pod, não do nó.&lt;br&gt;&lt;b&gt;A sua máquina:&lt;/b&gt; o cluster inteiro para. Por isso, em produção, os nós ficam em zonas de disponibilidade diferentes (veja a aba AWS)." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="770" width="930" height="130" as="geometry"/></mxCell><mxCell id="kindav" value="&lt;b&gt;⚠️ Armadilha (Sprint 8)&lt;/b&gt;&lt;br&gt;O aluno pode achar que &quot;Kubernetes roda dentro do Docker&quot; em produção. Não roda. Em produção, os nós são máquinas reais ou virtuais, como AWS EKS, Azure AKS ou Google GKE. O kind só simula esses nós com contêineres. A analogia &quot;cada contêiner é um servidor&quot; vale para entender a topologia do cluster, mas engana se o aluno concluir que o desempenho e o isolamento são iguais aos de servidores reais." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="770" width="930" height="130" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Legenda&lt;/b&gt; &amp;nbsp; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#ccfbf1;border:2px solid #0d9488&#x27;&gt;&lt;/span&gt; borda &amp;nbsp; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#fef9c3;border:2px solid #ca8a04&#x27;&gt;&lt;/span&gt; identidade &amp;nbsp; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#cffafe;border:2px solid #0891b2&#x27;&gt;&lt;/span&gt; BFF &amp;nbsp; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#dbeafe;border:2px solid #2563eb&#x27;&gt;&lt;/span&gt; domínio (tracejado: consumidor) &amp;nbsp; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#fae8ff;border:2px solid #a21caf&#x27;&gt;&lt;/span&gt; adaptador &amp;nbsp; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#fff7ed;border:2px solid #ea580c&#x27;&gt;&lt;/span&gt; mensageria &amp;nbsp; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#dcfce7;border:2px solid #16a34a&#x27;&gt;&lt;/span&gt; banco &amp;nbsp; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#f1f5f9;border:2px solid #475569&#x27;&gt;&lt;/span&gt; observabilidade &amp;nbsp; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#ffffff;border:2px solid #64748b&#x27;&gt;&lt;/span&gt; simulador de sistema externo &amp;nbsp; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#e2e8f0;border:2px solid #475569&#x27;&gt;&lt;/span&gt; sistema do Kubernetes&lt;br&gt;Nas Sprints 0 a 7, o laboratório roda com Docker Compose. A partir da Sprint 8, roda no kind." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="915" width="1880" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dep-aws" name="Implantação · AWS"><mxGraphModel dx="1920" dy="1370" grid="1" gridSize="10" guides="1" page="1" pageWidth="1920" pageHeight="1370" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&#x27;font-size:22px&#x27;&gt;PagUai · Visão de implantação e resiliência · Sprints 8 e 9 · AWS&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:14px;color:#475569&#x27;&gt;Pergunta que este desenho responde: onde cada peça roda fisicamente e o que acontece se uma zona de disponibilidade cair? Uma composição possível, não a única. Empresa e dados fictícios.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1880" height="60" as="geometry"/></mxCell><mxCell id="zu" value="" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="190" height="1070" as="geometry"/></mxCell><mxCell id="zu_h" value="1. Usuários e DNS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7c3aed;strokeColor=#7c3aed;fontColor=#ffffff;fontStyle=1;fontSize=13;align=left;spacingLeft=34;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="190" height="26" as="geometry"/></mxCell><mxCell id="zu_hb" value="" style="rounded=1;arcSize=20;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="25" y="62.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="zu_hi" value="" style="shape=mxgraph.networks.users;html=1;fillColor=#7c3aed;gradientColor=none;strokeColor=#ffffff;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="27" y="64.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="app" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7c3aed;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="28" y="290" width="175" height="85" as="geometry"/></mxCell><mxCell id="app_tag" value="FRONT-END" style="rounded=1;arcSize=50;html=1;fillColor=#7c3aed;strokeColor=#7c3aed;fontColor=#ffffff;fontSize=10;fontS