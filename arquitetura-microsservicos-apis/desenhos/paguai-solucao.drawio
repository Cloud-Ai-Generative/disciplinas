"1" parent="1"><mxGeometry x="916" y="1007" width="160" height="69" as="geometry"/></mxCell><mxCell id="o2" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1100" y="995" width="210" height="85" as="geometry"/></mxCell><mxCell id="o2_tag" value="OBSERVABILIDADE" style="rounded=1;arcSize=50;html=1;fillColor=#475569;strokeColor=#475569;fontColor=#ffffff;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1106" y="986" width="108" height="18" as="geometry"/></mxCell><mxCell id="o2_ic" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/management_governance/Log_Analytics_Workspaces.svg;" vertex="1" parent="1"><mxGeometry x="1109" y="1011" width="32" height="32" as="geometry"/></mxCell><mxCell id="o2_tx" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Log Analytics&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e3a8a&#x27;&gt;logs&lt;/span&gt;&lt;br&gt;&lt;i style=&#x27;font-size:11px;color:#475569&#x27;&gt;Sprint 10&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="1146" y="1007" width="160" height="69" as="geometry"/></mxCell><mxCell id="gh" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#374151;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="35" y="1165" width="140" height="150" as="geometry"/></mxCell><mxCell id="gh_lg" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=1;aspect=fixed;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="87.0" y="1175.0" width="36" height="32" as="geometry"/></mxCell><mxCell id="gh_tx" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e293b&#x27;&gt;repositório&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e3a8a&#x27;&gt;código e tags&lt;/span&gt;&lt;br&gt;&lt;i style=&#x27;font-size:11px;color:#475569&#x27;&gt;desde a Sprint 0&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="39" y="1211" width="132" height="100" as="geometry"/></mxCell><mxCell id="ga" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#374151;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="195" y="1165" width="185" height="150" as="geometry"/></mxCell><mxCell id="ga_lg" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=1;aspect=fixed;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="266.5" y="1175.0" width="42" height="32" as="geometry"/></mxCell><mxCell id="ga_tx" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e293b&#x27;&gt;build · testes&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e3a8a&#x27;&gt;Pact · Spectral · ZAP&lt;/span&gt;&lt;br&gt;&lt;i style=&#x27;font-size:11px;color:#475569&#x27;&gt;várias sprints&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="199" y="1211" width="177" height="100" as="geometry"/></mxCell><mxCell id="reg" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#374151;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="1190" width="205" height="95" as="geometry"/></mxCell><mxCell id="reg_tag" value="CI/CD" style="rounded=1;arcSize=50;html=1;fillColor=#374151;strokeColor=#374151;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="406" y="1181" width="49" height="18" as="geometry"/></mxCell><mxCell id="reg_ic" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/containers/Container_Registries.svg;" vertex="1" parent="1"><mxGeometry x="409" y="1206" width="32" height="32" as="geometry"/></mxCell><mxCell id="reg_tx" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Azure Container Registry&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e3a8a&#x27;&gt;registro de imagens&lt;/span&gt;&lt;br&gt;&lt;i style=&#x27;font-size:11px;color:#475569&#x27;&gt;Sprint 8&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="446" y="1202" width="155" height="79" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Legenda: cor = papel na arquitetura&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#f3e8ff;border:2px solid #7c3aed&#x27;&gt;&lt;/span&gt; front-end (fora do escopo) &amp;nbsp; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#ccfbf1;border:2px solid #0d9488&#x27;&gt;&lt;/span&gt; borda &amp;nbsp; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#fef9c3;border:2px solid #ca8a04&#x27;&gt;&lt;/span&gt; identidade e segurança&lt;br&gt;&lt;b&gt;microsserviços:&lt;/b&gt; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#cffafe;border:2px solid #0891b2&#x27;&gt;&lt;/span&gt; BFF &amp;nbsp; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#dbeafe;border:2px solid #2563eb&#x27;&gt;&lt;/span&gt; domínio (tracejado: consumidor) &amp;nbsp; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#fae8ff;border:2px solid #a21caf&#x27;&gt;&lt;/span&gt; adaptador&lt;br&gt;&lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#fff7ed;border:2px solid #ea580c&#x27;&gt;&lt;/span&gt; mensageria &amp;nbsp; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#f1f5f9;border:2px solid #475569&#x27;&gt;&lt;/span&gt; observabilidade e serviços gerenciados &amp;nbsp; &lt;span style=&#x27;display:inline-block;width:11px;height:11px;background:#e5e7eb;border:2px solid #374151&#x27;&gt;&lt;/span&gt; CI/CD&lt;br&gt;&lt;span style=&#x27;color:#7c3aed&#x27;&gt;▭&lt;/span&gt; borda roxa: rede privada &amp;nbsp; &lt;span style=&#x27;color:#326ce5&#x27;&gt;▭&lt;/span&gt; borda azul: cluster Kubernetes&lt;br&gt;&lt;span style=&#x27;color:#16a34a&#x27;&gt;▭&lt;/span&gt; verde: banco gerenciado; cada microsserviço acessa só a instância com o seu nome&lt;br&gt;&lt;span style=&#x27;color:#dc2626&#x27;&gt;━━ ①&lt;/span&gt; fluxo principal &amp;nbsp; &lt;span style=&#x27;color:#475569&#x27;&gt;━━&lt;/span&gt; síncrona &amp;nbsp; &lt;span style=&#x27;color:#dc2626&#x27;&gt;╍╍&lt;/span&gt; evento &amp;nbsp; &lt;span style=&#x27;color:#94a3b8&#x27;&gt;┈┈&lt;/span&gt; telemetria, segredos e deploy&lt;br&gt;Ícones: bibliotecas oficiais do draw.io. Logotipos: marcas dos respectivos projetos." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="1120" width="520" height="215" as="geometry"/></mxCell><mxCell id="muda" value="&lt;b&gt;☁️ O que muda em relação ao laboratório&lt;/b&gt;&lt;br&gt;• O API Management repassa WebSocket (exceto na camada Consumption), então o SignalR (⑨) segue pelo gateway, como no laboratório.&lt;br&gt;• O Service Bus substitui o RabbitMQ com outro modelo: um tópico com uma assinatura para cada consumidor.&lt;br&gt;• O Entra External ID substitui o Keycloak e é o sucessor do Azure AD B2C.&lt;br&gt;• Zonas de disponibilidade, DNS e NAT: veja a visão de implantação e resiliência (Sprints 8 e 9).&lt;br&gt;&lt;b&gt;Esta é uma composição possível, não a única.&lt;/b&gt; Critérios para decidir: quem opera, como é cobrado, recursos prontos, onde o sistema roda e o que o time domina." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="1120" width="720" height="215" as="geometry"/></mxCell><mxCell id="passos" value="&lt;b&gt;Fluxo principal: Ana Clara paga R$ 50 ao Seu Geraldo por PIX (Azure)&lt;/b&gt;&lt;br&gt;① O app envia o pagamento; o Application Gateway com WAF filtra a requisição e entrega ao Azure API Management, com o token JWT obtido no login.&lt;br&gt;② O gateway valida o token usando as chaves públicas do Microsoft Entra External ID.&lt;br&gt;③ O gateway encaminha a requisição, pela rede privada, ao Load Balancer interno, que a entrega a Pagamentos.&lt;br&gt;④ Pagamentos consulta Contas para descobrir a conta dona da chave PIX.&lt;br&gt;⑤ Pagamentos pergunta ao Antifraude, por gRPC, se a transação é segura. Se o Antifraude demorar ou falhar, entram as políticas de resiliência (Sprint 9).&lt;br&gt;⑥ Pagamentos debita, credita e registra os lançamentos na sua própria instância do Azure Database for PostgreSQL (servidor flexível), numa única transação.&lt;br&gt;⑦ Pagamentos publica o evento PagamentoAprovado no Azure Service Bus e responde ao app.&lt;br&gt;⑧ Cada consumidor recebe a sua cópia: Notificações envia o e-mail, Extrato atualiza o modelo de leitura e WebHooks avisa o sistema do lojista.&lt;br&gt;⑨ O app recebe o status ao vivo por SignalR (WebSocket), passando pelo API Management, como no laboratório." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="1355" width="1880" height="205" as="geometry"/></mxCell><mxCell id="e1" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#dc2626;strokeWidth=2.5;fontColor=#991b1b;fontStyle=1;exitX=1;exitY=0.25;entryX=0;entryY=0.7;" edge="1" parent="1" source="app" target="waf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1b" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#dc2626;strokeWidth=2.5;fontColor=#991b1b;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="waf" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;exitX=1;exitY=0.3;entryX=0;entryY=0.9;" edge="1" parent="1" source="portal" target="waf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="207" y="645"/><mxPoint x="207" y="213"/></Array></mxGeometry></mxCell><mxCell id="e2" value="②" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#dc2626;strokeWidth=2.5;fontColor=#991b1b;fontStyle=1;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="gw" target="idp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="③" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#dc2626;strokeWidth=2.5;fontColor=#991b1b;fontStyle=1;exitX=1;exitY=0.33;entryX=0;entryY=0.6;" edge="1" parent="1" source="gw" target="lb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3b" value="③" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#dc2626;strokeWidth=2.5;fontColor=#991b1b;fontStyle=1;exitX=1;exitY=0.3;entryX=0.25;entryY=0;" edge="1" parent="1" source="lb" target="pag"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="967" y="290"/></Array></mxGeometry></mxCell><mxCell id="e4" value="④ REST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#dc2626;strokeWidth=2.5;fontColor=#991b1b;fontStyle=1;exitX=0;exitY=0.4;entryX=1;entryY=0.43;" edge="1" parent="1" source="pag" target="contas"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="⑤ gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#dc2626;strokeWidth=2.5;fontColor=#991b1b;fontStyle=1;exitX=1;exitY=0.4;entryX=0;entryY=0.43;" edge="1" parent="1" source="pag" target="anti"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="⑥" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#dc2626;strokeWidth=2.5;fontColor=#991b1b;fontStyle=1;exitX=0;exitY=0.93;entryX=0.5;entryY=0;" edge="1" parent="1" source="pag" target="db2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="905" y="460"/><mxPoint x="905" y="772"/><mxPoint x="935" y="772"/></Array></mxGeometry></mxCell><mxCell id="e7" value="⑦" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#dc2626;strokeWidth=2.5;dashed=1;fontColor=#991b1b;fontStyle=1;exitX=0.9;exitY=1;entryX=0.75;entryY=1;" edge="1" parent="1" source="pag" target="mq"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1091" y="487"/><mxPoint x="1662" y="487"/></Array></mxGeometry></mxCell><mxCell id="e8ext" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#dc2626;strokeWidth=2.5;dashed=1;fontColor=#991b1b;fontStyle=1;exitX=0.12;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="mq" target="ext"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1544" y="650"/><mxPoint x="730" y="650"/></Array></mxGeometry></mxCell><mxCell id="e8notif" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endAr