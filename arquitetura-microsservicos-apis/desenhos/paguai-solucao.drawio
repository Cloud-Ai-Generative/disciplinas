vertex="1" parent="1"><mxGeometry x="1528" y="241" width="146" height="18" as="geometry"/></mxCell><mxCell id="mq_ic" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/integration/Service_Bus.svg;" vertex="1" parent="1"><mxGeometry x="1531" y="266" width="32" height="32" as="geometry"/></mxCell><mxCell id="mq_tx" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Azure Service Bus&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e293b&#x27;&gt;tópico: PagamentoAprovado&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e293b&#x27;&gt;3 assinaturas: extrato, notificacoes, webhooks&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e3a8a&#x27;&gt;modelo diferente do RabbitMQ&lt;/span&gt;&lt;br&gt;&lt;i style=&#x27;font-size:11px;color:#475569&#x27;&gt;Sprint 3&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="1568" y="262" width="136" height="154" as="geometry"/></mxCell><mxCell id="email" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1522" y="665" width="186" height="100" as="geometry"/></mxCell><mxCell id="email_tag" value="SERVIÇO GERENCIADO" style="rounded=1;arcSize=50;html=1;fillColor=#475569;strokeColor=#475569;fontColor=#ffffff;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1528" y="656" width="127" height="18" as="geometry"/></mxCell><mxCell id="email_ic" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/other/Azure_Communication_Services.svg;" vertex="1" parent="1"><mxGeometry x="1531" y="681" width="32" height="32" as="geometry"/></mxCell><mxCell id="email_tx" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Azure Communication Services&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e3a8a&#x27;&gt;envio de e-mail gerenciado&lt;/span&gt;&lt;br&gt;&lt;i style=&#x27;font-size:11px;color:#475569&#x27;&gt;Sprint 3&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="1568" y="677" width="136" height="84" as="geometry"/></mxCell><mxCell id="seg" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1522" y="790" width="186" height="110" as="geometry"/></mxCell><mxCell id="seg_tag" value="SEGURANÇA" style="rounded=1;arcSize=50;html=1;fillColor=#ca8a04;strokeColor=#ca8a04;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1528" y="781" width="77" height="18" as="geometry"/></mxCell><mxCell id="seg_ic" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="1531" y="806" width="32" height="32" as="geometry"/></mxCell><mxCell id="seg_tx" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Azure Key Vault&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e293b&#x27;&gt;senhas, chaves e certificados&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e3a8a&#x27;&gt;fora do código&lt;/span&gt;&lt;br&gt;&lt;i style=&#x27;font-size:11px;color:#475569&#x27;&gt;Sprint 11&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="1568" y="802" width="136" height="94" as="geometry"/></mxCell><mxCell id="banco" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1736" y="140" width="158" height="110" as="geometry"/></mxCell><mxCell id="banco_tag" value="EXTERNO" style="rounded=1;arcSize=50;html=1;fillColor=#64748b;strokeColor=#64748b;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1742" y="131" width="63" height="18" as="geometry"/></mxCell><mxCell id="banco_ic" value="" style="sha