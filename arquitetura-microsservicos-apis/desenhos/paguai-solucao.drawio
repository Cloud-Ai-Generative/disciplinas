;&gt;Amazon SNS + Amazon SQS&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e293b&#x27;&gt;tópico SNS: PagamentoAprovado&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e293b&#x27;&gt;3 filas SQS: extrato, notificacoes, webhooks&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e3a8a&#x27;&gt;modelo diferente do RabbitMQ&lt;/span&gt;&lt;br&gt;&lt;i style=&#x27;font-size:11px;color:#475569&#x27;&gt;Sprint 3&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="1568" y="262" width="136" height="154" as="geometry"/></mxCell><mxCell id="email" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1522" y="665" width="186" height="100" as="geometry"/></mxCell><mxCell id="email_tag" value="SERVIÇO GERENCIADO" style="rounded=1;arcSize=50;html=1;fillColor=#475569;strokeColor=#475569;fontColor=#ffffff;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1528" y="656" width="127" height="18" as="geometry"/></mxCell><mxCell id="email_ic" value="" style="sketch=0;outlineConnect=0;fillColor=#DD344C;strokeColor=#ffffff;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_email_service;" vertex="1" parent="1"><mxGeometry x="1531" y="681" width="32" height="32" as="geometry"/></mxCell><mxCell id="email_tx" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Amazon SES&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#1e3a8a&#x27;&gt;envio de e-mail gerenciado&lt;/span&gt;&lt;br&gt;&lt;i style=&#x27;font-size:11px;color:#475569&#x27;&gt;Sprint 3&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="1568" y="677" width="136" height="84" as="geometry"/></mxCell><mxCell id="seg" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef9c3;stroke