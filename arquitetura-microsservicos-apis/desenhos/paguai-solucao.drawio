l><mxCell id="s9" value="SMTP / API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;exitX=0.8;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="notif" target="email"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1072" y="672"/><mxPoint x="1500" y="672"/><mxPoint x="1500" y="715"/></Array></mxGeometry></mxCell><mxCell id="s10" value="HTTPS + HMAC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;exitX=1;exitY=0.5;entryX=0;entryY=0.9;" edge="1" parent="1" source="hooks" target="sl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t1" value="OTLP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;dashed=1;dashPattern=2 3;fontColor=#475569;exitX=0.119;exitY=1;entryX=0.521;entryY=0;" edge="1" parent="1" source="col" target="z5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t2" value="lê segredos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;dashed=1;dashPattern=2 3;fontColor=#475569;exitX=1;exitY=0.97;entryX=0;entryY=0.5;" edge="1" parent="1" source="zc" target="seg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1502" y="845"/></Array></mxGeometry></mxCell><mxCell id="t6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;dashed=1;dashPattern=2 3;fontColor=#475569;" edge="1" parent="1" source="gh" target="ga"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;dashed=1;dashPattern=2 3;fontColor=#475569;" edge="1" parent="1" source="ga" target="reg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t8" value="deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;dashed=1;dashPattern=2 3;fontColor=#475569;exitX=0.5;exitY=0;entryX=0;entryY=0.977;" edge="1" parent="1" source="reg" target="zc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="502" y="1110"/><mxPoint x="437" y="1110"/><mxPoint x="437" y="720"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="gcp" name="Solução · Google Cloud"><mxGraphModel dx="1900" dy="1580" grid="1" gridSize="10" guides="1" page="1" pageWidth="1920" pageHeight="1580" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&#x27;font-size:22px&#x27;&gt;PagUai · Desenho de solução · Sprint 13 · versão nuvem: Google Cloud&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:14px;color:#475569&#x27;&gt;Pergunta que este desenho responde: como a mesma solução do laboratório ficaria com os serviços gerenciados do Google Cloud? Uma composição possível, não a única. Empresa e dados fictícios. O aluno não executa esta versão.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1880" height="60" as="geometry"/></mxCell><mxCell id="z1" value="" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="180" height="1040" as="geometry"/></mxCell><mxCell id="z1_h" value="1. Canais (front-end)" style="rounded=0